# Public browser-safe values
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Store identity: set these per retailer when creating a new deployment.
# Defaults are generic demo values; do not use a retailer's identity without permission.
NEXT_PUBLIC_STORE_NAME=Demo Tech Store
NEXT_PUBLIC_STORE_SHORT_NAME=DEMO TECH
NEXT_PUBLIC_STORE_TAGLINE=Smarter tech. Better value.
NEXT_PUBLIC_STORE_DESCRIPTION=Browse technology, electronics and everyday essentials from our online store.
NEXT_PUBLIC_STORE_LOCALE=en_NG
NEXT_PUBLIC_STORE_LANGUAGE=en-NG
NEXT_PUBLIC_STORE_CURRENCY=NGN
NEXT_PUBLIC_STORE_LOCATION=Nigeria
NEXT_PUBLIC_STORE_CITY=
NEXT_PUBLIC_STORE_STATE=
# IANA time zone used for CRM follow-up entry and display.
NEXT_PUBLIC_STORE_TIME_ZONE=Africa/Lagos
# Must be explicitly enabled for the checkout form to collect customer details.
# The database must independently enable checkout; this flag alone cannot enable orders.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Server-only values — NEVER prefix secrets with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional integrations
WHATSAPP_SUPPORT_NUMBER=
